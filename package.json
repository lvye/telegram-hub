{
  "name": "telegram-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:types:generate": "wrangler types",
    "cf:types:check": "wrangler types --check",
    "check": "npm run cf:types:check && npm run ts:check && npm run lint && npm test && npm run test:smoke && npm run deploy:dry",
    "db:migrations:list:local": "wrangler d1 migrations list telegram-hub-prod --local",
    "db:migrations:list:remote": "wrangler d1 migrations list telegram-hub-prod --remote",
    "db:migrate:local": "wrangler d1 migrations apply telegram-hub-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply telegram-hub-prod --remote",
    "db:schema:check": "vitest run test/schema.test.ts",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/check",
    "dev": "wrangler dev",
    "lint": "oxlint --type-aware --deny typescript/no-floating-promises src/",
    "test": "vitest run",
    "test:smoke": "node --test scripts/smoke-health.node.mjs",
    "test:watch": "vitest",
    "ts:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.10",
    "@types/node": "^26.6.6",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  },
  "dependencies": {
    "domhandler": "^6.0.1",
    "fast-xml-parser": "^5.11.2",
    "htmlparser2": "^12.0.0"
  }
}
